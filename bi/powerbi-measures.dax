// Governed Power BI measures. Names map one-to-one to registry/metrics.json.
HMDA Records = COUNTROWS('HMDA Applications')
Applications Decided = CALCULATE([HMDA Records], 'HMDA Applications'[action_taken] IN {1,2,3})
Originated Loans = CALCULATE([HMDA Records], 'HMDA Applications'[action_taken] = 1)
Approved Not Accepted = CALCULATE([HMDA Records], 'HMDA Applications'[action_taken] = 2)
Denied Applications = CALCULATE([HMDA Records], 'HMDA Applications'[action_taken] = 3)
Withdrawn Applications = CALCULATE([HMDA Records], 'HMDA Applications'[action_taken] = 4)
Incomplete Applications = CALCULATE([HMDA Records], 'HMDA Applications'[action_taken] = 5)
Denial Rate = DIVIDE([Denied Applications], [Applications Decided])
Origination Rate = DIVIDE([Originated Loans], [Applications Decided])
Average Loan Amount ($000s) = AVERAGEX(FILTER('HMDA Applications','HMDA Applications'[loan_amount_000s] > 0),'HMDA Applications'[loan_amount_000s])
Median Loan Amount ($000s) = MEDIANX(FILTER('HMDA Applications','HMDA Applications'[loan_amount_000s] > 0),'HMDA Applications'[loan_amount_000s])
Average Applicant Income ($000s) = AVERAGEX(FILTER('HMDA Applications','HMDA Applications'[applicant_income_000s] > 0),'HMDA Applications'[applicant_income_000s])
Conventional Loan Share = DIVIDE(CALCULATE([HMDA Records],'HMDA Applications'[loan_type] = 1),[HMDA Records])
FHA Loan Share = DIVIDE(CALCULATE([HMDA Records],'HMDA Applications'[loan_type] = 2),[HMDA Records])
VA Loan Share = DIVIDE(CALCULATE([HMDA Records],'HMDA Applications'[loan_type] = 3),[HMDA Records])
Home Purchase Share = DIVIDE(CALCULATE([HMDA Records],'HMDA Applications'[loan_purpose] = 1),[HMDA Records])
Refinance Share = DIVIDE(CALCULATE([HMDA Records],'HMDA Applications'[loan_purpose] = 3),[HMDA Records])
Order Count = COUNTROWS('Orders')
Closed Orders = CALCULATE([Order Count],'Orders'[status] = "closed")
Open Orders = CALCULATE([Order Count],'Orders'[status] = "open")
Cancellation Rate = DIVIDE(CALCULATE([Order Count],'Orders'[status] = "cancelled"),[Order Count])
Close Rate = DIVIDE([Closed Orders],[Order Count])
Average Order Value = AVERAGE('Orders'[order_value])
Closed Order Value = CALCULATE(SUM('Orders'[order_value]),'Orders'[status] = "closed")
Net Revenue = SUM('Finance Transactions'[amount])
